{
  "name": "@midnightntwrk/dapp-connector-api",
  "version": "4.1.0-beta.1",
  "packageManager": "yarn@4.17.0",
  "description": "Midnight DApp Connector API",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "main": "dist/index.mjs",
  "type": "module",
  "author": "Midnight Foundation",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./globals": {
      "types": "./dist/globals.d.ts"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-dapp-connector-api.git"
  },
  "scripts": {
    "build": "rm -rf ./dist && rollup -c ./rollup.config.mjs",
    "lint": "eslint src",
    "format": "prettier --write '**/*.{md}'",
    "build:docs": "typedoc --validation --plugin typedoc-plugin-markdown --options typedoc.json",
    "changeset": "changeset",
    "changeset:version": "changeset version && yarn install --mode=update-lockfile",
    "changeset:check": "changeset status --verbose"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@eslint/js": "^10.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node24": "^24.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "rollup": "^4.30.1",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.4.1",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.20.0"
  }
}
